---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import AnnouncementCard from "../components/AnnouncementCard.astro";

const all = await getCollection("announcements");
const sorted = all.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
const latest = sorted.slice(0, 3);
---

<Base>
  <!-- Identity band: the local number is the identity for members -->
  <section class="hero">
    <div class="wrap hero__inner">
      <p class="hero__kicker">United Steelworkers Local</p>
      <h1 class="hero__number">5025-02</h1>
      <p class="hero__where">Fireline, Inc. &nbsp;/&nbsp; Youngstown, Ohio</p>
      <p class="hero__line">
        The union of the workers who build the crucibles. News, your contract,
        and the resources you need, in one place.
      </p>
      <div class="hero__actions">
        <a href="/documents" class="btn btn--gold">Read the contract</a>
        <a href="/contact" class="btn btn--ghost btn--ghost-onnavy">Submit a concern</a>
      </div>
    </div>
  </section>

  <div class="wrap columns bay">
    <!-- Latest news -->
    <section class="news-col">
      <div class="marker">Latest news</div>
      {
        latest.length > 0 ? (
          <div class="news-list">
            {latest.map((a) => (
              <AnnouncementCard
                href={`/news/${a.id}`}
                title={a.data.title}
                date={a.data.date}
                summary={a.data.summary}
                pinned={a.data.pinned}
              />
            ))}
          </div>
        ) : (
          <p class="empty">No announcements posted yet. Check back soon.</p>
        )
      }
      {latest.length > 0 && (
        <p class="news-all"><a href="/news" class="btn btn--ghost">All news</a></p>
      )}
    </section>

    <!-- Quick access -->
    <aside class="quick">
      <div class="marker">Quick access</div>
      <ul class="quick__list">
        <li>
          <a href="/documents#cba">
            <span class="quick__title">Collective Bargaining Agreement</span>
            <span class="quick__sub">2024&ndash;2027 contract (PDF)</span>
          </a>
        </li>
        <li>
          <a href="/documents#elections">
            <span class="quick__title">USW Elections Manual</span>
            <span class="quick__sub">Officer election rules (PDF)</span>
          </a>
        </li>
        <li>
          <a href="/contact">
            <span class="quick__title">Contact a Rep</span>
            <span class="quick__sub">Questions, grievances, or ideas</span>
          </a>
        </li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  .hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #fff;
    border-bottom: 4px solid var(--gold);
  }
  .hero__inner { padding-block: clamp(2.5rem, 7vw, 5rem); }
  .hero__kicker {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: #9fc3dc;
    margin: 0 0 0.3rem;
  }
  .hero__number {
    font-size: clamp(3.6rem, 13vw, 8rem);
    line-height: 0.9;
    margin: 0;
    color: #fff;
    letter-spacing: 0.01em;
  }
  .hero__where {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--gold);
    margin: 0.6rem 0 1.2rem;
  }
  .hero__line { color: #dce7ef; max-width: 46ch; margin: 0 0 1.8rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .btn--ghost-onnavy { color: #fff; border-color: #fff; }
  .btn--ghost-onnavy:hover { background: #fff; color: var(--navy-deep); }

  .columns {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .news-list { display: grid; gap: 1rem; }
  .news-all { margin-top: 1.4rem; }
  .empty {
    background: var(--card);
    border: 1px dashed var(--line);
    padding: 1.5rem;
    border-radius: var(--radius);
    color: var(--steel);
  }

  .quick__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .quick__list a {
    display: block;
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
    border-left: 4px solid var(--gold);
    transition: background 120ms ease;
  }
  .quick__list a:hover { background: var(--navy-deep); }
  .quick__title { display: block; font-family: var(--display); font-weight: 600; font-size: 1.15rem; }
  .quick__sub { display: block; font-size: 0.9rem; color: #b9cdda; margin-top: 0.15rem; }

  @media (max-width: 820px) {
    .columns { grid-template-columns: 1fr; }
  }
</style>

---
import Base from "../layouts/Base.astro";
---

<Base title="About" description="About USW Local 5025-02 at Fireline, Inc. in Youngstown, Ohio.">
  <section class="pagehead">
    <div class="wrap">
      <h1>About the local</h1>
      <p>Who we are and how the local works.</p>
    </div>
  </section>

  <div class="wrap bay about">
    <div class="about__body">
      <p class="lede">
        USW Local 5025-02 represents the workers of Fireline, Inc. in Youngstown,
        Ohio.
      </p>

      <div class="marker">What the local does</div>
      <p>
        We negotiate and enforce the contract, handle grievances, and stand
        together on wages, benefits, safety, and fair treatment on the floor.
        Every member has a voice, and the officers answer to the membership.
            </p>

      <div class="marker">Officers &amp; stewards</div>

      <div class="roster">
        <div class="roster__group">
          <h2 class="roster__head">Officers</h2>
          <ul class="roster__list">
            <li class="roster__item">
              <span class="roster__role">Unit Chair</span>
              <span class="roster__name">Jeff Perry</span>
            </li>
            <li class="roster__item">
              <span class="roster__role">Unit Recording Secretary</span>
              <span class="roster__name">Brian Serrecchio</span>
            </li>
            <li class="roster__item">
              <span class="roster__role">Unit Grievance Officer</span>
              <span class="roster__name">Zach Schmidt</span>
            </li>
          </ul>
        </div>

        <div class="roster__group">
          <h2 class="roster__head">Stewards</h2>
          <ul class="roster__list">
            <li class="roster__item">
              <span class="roster__role">Third Shift Steward</span>
              <span class="roster__name">Jerry Lawson</span>
            </li>
          </ul>
        </div>
      </div>

      <p class="roster__note">
        To reach any officer or steward, use the <a href="/contact">contact page</a> and we'll route your message. DO NOT Share personal or sensitive information. DO NOT post grievances or personal issues on social media. The local will not respond to those posts, and it may violate the contract.
      </p>

      <div class="marker">Meetings</div>
      <p>
        The membership meeting is where decisions get made. Times and locations
        are posted under <a href="/news">News</a>. Show up, that's how a local
        stays strong.
      </p>
    </div>

    <aside class="factbox">
      <h2 class="factbox__h">At a glance</h2>
      <dl>
        <dt>Local</dt>
        <dd>USW 5025-02</dd>
        <dt>Employer</dt>
        <dd>Fireline, Inc.</dd>
        <dt>Location</dt>
        <dd>Youngstown, Ohio</dd>
        <dt>Contract</dt>
        <dd><a href="/documents#cba">2024–2027 CBA</a></dd>
        <dt>International</dt>
        <dd><a href="https://www.usw.org" rel="noopener">United Steelworkers</a></dd>
      </dl>
    </aside>
  </div>
</Base>

<style>
    .roster { display: grid; gap: 2.4rem; max-width: 720px; margin-top: 1.5rem; }
  .roster__head {
    display: flex; align-items: center; gap: 0.7rem;
    font-family: var(--display); font-weight: 700;
    font-size: var(--step-2); color: var(--navy);
    text-transform: uppercase; letter-spacing: 0.03em;
    margin: 0 0 1rem;
  }
  .roster__head::before {
    content: ""; width: 34px; height: 5px; background: var(--gold); flex: none;
  }
  .roster__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .roster__item {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--line);
  }
  .roster__role {
    flex: 0 0 200px;
    font-family: var(--display); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    font-size: 0.9rem; color: var(--steel-soft);
  }
  .roster__name { font-family: var(--display); font-weight: 700; font-size: var(--step-1); color: var(--ink); }
  .roster__note { margin-top: 2rem; color: var(--steel); }
  .pagehead {
    background: var(--navy);
    color: #fff;
    border-bottom: 4px solid var(--gold);
    padding-block: clamp(2rem, 5vw, 3.2rem);
  }
  .pagehead h1 { margin: 0 0 0.3rem; }
  .pagehead p { margin: 0; color: #dce7ef; }

  .about {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .lede { font-size: var(--step-1); color: var(--ink); margin-bottom: 2rem; }
  .about .marker { margin-top: 2rem; }

  .factbox {
    background: var(--navy);
    color: #fff;
    border-radius: var(--radius);
    border-top: 5px solid var(--gold);
    padding: 1.5rem 1.6rem;
  }
  .factbox__h { color: #fff; font-size: var(--step-1); margin-bottom: 1rem; }
  .factbox dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1rem; }
  .factbox dt {
    font-family: var(--display);
    font-weight: 600;
    color: var(--gold);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    align-self: center;
  }
  .factbox dd { margin: 0; color: #e6eef4; }
  .factbox a { color: #fff; }
  .factbox a:hover { color: var(--gold); }

  @media (max-width: 780px) {
    .about { grid-template-columns: 1fr; }
  }
</style>

---
import Base from "../../../layouts/Base.astro";

// GATED PAGE. Protected by Basic-Auth on /members/portal (see scripts/gen-headers.mjs).
// Files live in /public/members/portal/ so they sit behind the same password.
const docs = [
  {
    title: "Benefits Summary",
    period: "2026",
    desc: "Health, dental, and vision coverage at a glance, with what changed this year.",
    file: "/members/portal/benefits-summary.pdf",
  },
  {
    title: "Open Enrollment Guide",
    period: "2026",
    desc: "How and when to enroll or change your elections, with the forms you need.",
    file: "/members/portal/open-enrollment-2026.pdf",
  },
];
---

<Base title="Members area" description="Members-only resources for USW Local 5025-02.">
  <section class="pagehead">
    <div class="wrap">
      <h1>Members area</h1>
      <p>Benefits and member-only resources for Local 5025-02.</p>
    </div>
  </section>

  <div class="wrap bay">
    <div class="docs">
      {
        docs.map((d) => (
          <article class="doc">
            <div class="doc__main">
              <p class="doc__period">{d.period}</p>
              <h2 class="doc__title">{d.title}</h2>
              <p class="doc__desc">{d.desc}</p>
            </div>
            <div class="doc__action">
              <a href={d.file} class="btn btn--gold" download>Download PDF</a>
              <a href={d.file} class="doc__view" target="_blank" rel="noopener">View in browser</a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="docs__note">Need something added here? <a href="/contact">Ask a rep</a>.</p>
  </div>
</Base>

<style>
  .pagehead { background: var(--navy); color: #fff; border-bottom: 4px solid var(--gold); padding-block: clamp(2rem, 5vw, 3.2rem); }
  .pagehead h1 { margin: 0 0 0.3rem; }
  .pagehead p { margin: 0; color: #dce7ef; }
  .docs { display: grid; gap: 1.1rem; max-width: 860px; }
  .doc { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; background: var(--card); border: 1px solid var(--line); border-left: 6px solid var(--gold); border-radius: var(--radius); padding: 1.4rem 1.5rem; }
  .doc__main { flex: 1 1 320px; }
  .doc__period { font-family: var(--display); font-weight: 600; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--steel-soft); margin: 0 0 0.2rem; }
  .doc__title { margin: 0 0 0.5rem; font-size: var(--step-2); }
  .doc__desc { margin: 0; color: var(--ink); max-width: 60ch; }
  .doc__action { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .doc__view { font-family: var(--display); font-weight: 600; font-size: 0.9rem; color: var(--navy); text-decoration: none; }
  .doc__view:hover { color: var(--gold-deep); }
  .docs__note { margin-top: 2rem; color: var(--steel); }
</style>

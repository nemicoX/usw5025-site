---
import Base from "../../layouts/Base.astro";
---

<Base title="Members" description="Members-only resources for USW Local 5025-02. Request access through the contact form.">
  <section class="pagehead">
    <div class="wrap">
      <h1>Members area</h1>
      <p>Benefits and member-only resources for Local 5025-02.</p>
    </div>
  </section>

  <div class="wrap bay gate">
    <div class="gate__card">
      <h2 class="gate__h">This section is password-protected</h2>
      <p>
        The members area holds benefits documents and other resources meant for
        Local 5025-02 members only. You'll need the members password to open it.
      </p>
      <div class="gate__actions">
        <a href="/members/portal" class="btn btn--gold">Enter the members area</a>
        <a href="/contact" class="btn btn--ghost">Request the password</a>
      </div>
    </div>

    <aside class="gate__side">
      <h3 class="gate__side-h">Don't have the password?</h3>
      <p>
        Request it through the <a href="/contact">contact form</a> and we'll email
        you the password. Pick <strong>Request members password</strong> as the
        topic, and include your employee number in the message so we can confirm
        you're a member.
      </p>
    </aside>
  </div>
</Base>

<style>
  .pagehead { background: var(--navy); color: #fff; border-bottom: 4px solid var(--gold); padding-block: clamp(2rem, 5vw, 3.2rem); }
  .pagehead h1 { margin: 0 0 0.3rem; }
  .pagehead p { margin: 0; color: #dce7ef; }
  .gate { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .gate__card { background: var(--card); border: 1px solid var(--line); border-left: 6px solid var(--gold); border-radius: var(--radius); padding: clamp(1.4rem, 3vw, 2rem); }
  .gate__h { margin: 0 0 0.8rem; font-size: var(--step-2); }
  .gate__card p { color: var(--ink); max-width: 58ch; }
  .gate__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }
  .gate__side { background: var(--paper); border-left: 4px solid var(--gold); border-radius: var(--radius); padding: 1.3rem 1.4rem; }
  .gate__side-h { font-size: var(--step-1); margin: 0 0 0.5rem; }
  .gate__side p { color: var(--steel); margin: 0; }
  @media (max-width: 780px) { .gate { grid-template-columns: 1fr; } }
</style>

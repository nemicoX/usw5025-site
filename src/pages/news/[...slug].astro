---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const all = await getCollection("announcements");
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateStr = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const dateISO = entry.data.date.toISOString().slice(0, 10);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="wrap post bay">
    <p class="post__back"><a href="/news">← Back to news</a></p>
    <time class="post__date" datetime={dateISO}>{dateStr}</time>
    <h1 class="post__title">{entry.data.title}</h1>
    <div class="post__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post { max-width: 720px; }
  .post__back { margin: 0 0 1.5rem; }
  .post__back a {
    font-family: var(--display);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }
  .post__date { color: var(--steel); font-size: 0.9rem; }
  .post__title { margin: 0.3rem 0 1.5rem; }
  .post__body :global(h2) { font-size: var(--step-2); margin-top: 2rem; }
  .post__body :global(h3) { margin-top: 1.6rem; }
  .post__body :global(ul),
  .post__body :global(ol) { padding-left: 1.3rem; }
  .post__body :global(li) { margin-bottom: 0.4rem; }
  .post__body :global(a) { color: var(--navy); }
  .post__body :global(blockquote) {
    border-left: 4px solid var(--gold);
    margin: 1.5rem 0;
    padding: 0.4rem 0 0.4rem 1.2rem;
    color: var(--steel);
    font-style: italic;
  }
</style>
